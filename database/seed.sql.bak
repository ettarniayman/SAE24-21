INSERT INTO blog_posts (slug,title_fr,title_en,excerpt_fr,excerpt_en,content_fr,category_id,is_published,is_featured,view_count,published_at) VALUES
('top-10-medinas-maroc','Top 10 des mÃ©dinas Ã  visiter au Maroc','Top 10 medinas to visit in Morocco',
'De Marrakech Ã  FÃ¨s en passant par Chefchaouen, dÃ©couvrez les mÃ©dinas les plus fascinantes du Maroc.','From Marrakech to Fes via Chefchaouen, discover Morocco''s most fascinating medinas.',
'<p>Le Maroc possÃ¨de certaines des mÃ©dinas les plus authentiques et prÃ©servÃ©es du monde entier. Inscrites au patrimoine mondial de l''UNESCO pour la plupart, elles sont le reflet vivant d''une civilisation millÃ©naire.</p><h2>1. La mÃ©dina de FÃ¨s</h2><p>La plus grande mÃ©dina mÃ©diÃ©vale du monde, avec ses 9 500 ruelles, ses tanneries lÃ©gendaires et ses mosquÃ©es ancestrales.</p><h2>2. La mÃ©dina de Marrakech</h2><p>Autour de la mythique place Jemaa El-Fna, un labyrinthe de souks thÃ©matiques oÃ¹ tous les sens s''Ã©veillent.</p><h2>3. Chefchaouen</h2><p>La ville bleue du Rif, oÃ¹ chaque ruelle peinte en nuances d''azur est une invitation Ã  la photographie.</p>',
(SELECT id FROM blog_categories WHERE slug='voyage'),TRUE,TRUE,1247,'2025-05-15'),

('guide-sahara-marocain','Guide complet : voyager dans le Sahara marocain','Complete guide: travelling in the Moroccan Sahara',
'Tout ce qu''il faut savoir pour prÃ©parer votre aventure dans le dÃ©sert marocain : Merzouga, bivouac, chameau et Ã©toiles.','Everything you need to know to prepare your Moroccan desert adventure.',
'<p>Le Sahara marocain est l''une des expÃ©riences les plus inoubliables qu''un voyageur puisse vivre. Voici notre guide complet pour prÃ©parer votre aventure.</p><h2>Quand partir ?</h2><p>La meilleure saison est d''octobre Ã  avril, quand les tempÃ©ratures sont douces (20-28Â°C le jour). L''Ã©tÃ© est dÃ©conseillÃ© (40-50Â°C).</p><h2>Comment y aller ?</h2><p>Depuis Marrakech, comptez 8-9h de route via le col de Tichka et Ouarzazate. Les circuits organisÃ©s sont la meilleure option.</p>',
(SELECT id FROM blog_categories WHERE slug='conseils'),TRUE,FALSE,834,'2025-04-22'),

('experience-football-espagne','Football Experience : BernabÃ©u et Camp Nou en 7 jours','Football Experience: BernabÃ©u and Camp Nou in 7 days',
'Notre programme Football Experience Espagne vous emmÃ¨ne dans les temples du football mondial Ã  Madrid et Barcelone.','Our Football Experience Spain program takes you to the world''s football temples.',
'<p>Pour tout fan de football, visiter le BernabÃ©u et le Camp Nou est un rÃªve absolu. Notre programme de 7 jours vous permet de vivre cette expÃ©rience de faÃ§on unique.</p><h2>Jour 1-3 : Madrid</h2><p>Tour officiel du stade Santiago BernabÃ©u, musÃ©e Real Madrid, et si possible assistance Ã  un match. Visite du Prado et tapas en soirÃ©e.</p><h2>Jour 4-7 : Barcelone</h2><p>Camp Nou Experience, musÃ©e FC Barcelona, Barceloneta et architecture de GaudÃ­.</p>',
(SELECT id FROM blog_categories WHERE slug='voyage'),TRUE,TRUE,2156,'2025-06-01'),

('gastronomie-marocaine-secrets','Les secrets de la gastronomie marocaine','The secrets of Moroccan gastronomy',
'Tajine, couscous, pastilla, hariraâ€¦ plongez au cÅ“ur des saveurs et Ã©pices qui font la richesse de la cuisine marocaine.','Tagine, couscous, pastilla, harira... dive into the flavors and spices of Moroccan cuisine.',
'<p>La cuisine marocaine est l''une des plus riches et complexes du monde, fruit d''un brassage de cultures berbÃ¨re, arabe, andalouse et africaine.</p><h2>Le tajine</h2><p>Cuit lentement dans son plat conique en terre cuite, le tajine dÃ©veloppe des arÃ´mes incomparables.</p><h2>Le couscous du vendredi</h2><p>Plat traditionnel servi aprÃ¨s la priÃ¨re du vendredi, le couscous est bien plus qu''un repas, c''est un rituel familial.</p>',
(SELECT id FROM blog_categories WHERE slug='gastronomie'),TRUE,FALSE,567,'2025-05-28');

