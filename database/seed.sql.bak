INSERT INTO faq_items (category_id,question_fr,question_en,answer_fr,answer_en,sort_order,is_active) VALUES
((SELECT id FROM faq_categories WHERE slug='reservation'),
'Comment rÃ©server un voyage avec RT Voyage ?',
'How do I book a trip with RT Voyage?',
'Vous pouvez rÃ©server directement sur notre site en sÃ©lectionnant votre programme, ou nous contacter par tÃ©lÃ©phone au +212 5 22 XX XX XX ou par email Ã  contact@rtvoyage.ma. Un acompte de 30% est demandÃ© Ã  la rÃ©servation.',
'You can book directly on our website by selecting your program, or contact us by phone or email. A 30% deposit is required at booking.',
1,TRUE),

((SELECT id FROM faq_categories WHERE slug='reservation'),
'Quels modes de paiement acceptez-vous ?',
'What payment methods do you accept?',
'Nous acceptons les virements bancaires, les cartes bancaires (Visa, Mastercard) et les espÃ¨ces en agence. Le paiement en ligne est sÃ©curisÃ© via SSL.',
'We accept bank transfers, credit cards (Visa, Mastercard) and cash at our agency. Online payment is secured via SSL.',
2,TRUE),

((SELECT id FROM faq_categories WHERE slug='voyage'),
'Les programmes incluent-ils les vols ?',
'Do the programs include flights?',
'Nos prix affichÃ©s n''incluent gÃ©nÃ©ralement pas les vols internationaux. Nous pouvons cependant vous proposer les meilleures offres de nos compagnies partenaires (RAM, Air France, Transavia).',
'Our displayed prices generally do not include international flights. However, we can offer you the best deals from our partner airlines.',
1,TRUE),

((SELECT id FROM faq_categories WHERE slug='pratique'),
'Ai-je besoin d''un visa pour voyager au Maroc ?',
'Do I need a visa to travel to Morocco?',
'Les ressortissants de nombreux pays (France, Espagne, Canada, USA, UE...) peuvent entrer au Maroc sans visa pour un sÃ©jour touristique de moins de 90 jours. Votre passeport doit Ãªtre valide au moins 6 mois.',
'Citizens of many countries (France, Spain, Canada, USA, EU...) can enter Morocco without a visa for tourist stays under 90 days. Your passport must be valid for at least 6 months.',
1,TRUE),

((SELECT id FROM faq_categories WHERE slug='annulation'),
'Quelle est votre politique d''annulation ?',
'What is your cancellation policy?',
'Annulation plus de 60 jours avant le dÃ©part : remboursement moins 10% de frais. Entre 30 et 60 jours : 50% retenu. Moins de 30 jours : aucun remboursement. Nous recommandons fortement une assurance voyage.',
'Cancellation more than 60 days before departure: refund minus 10% admin fees. 30-60 days: 50% retained. Less than 30 days: no refund. We strongly recommend travel insurance.',
1,TRUE),

((SELECT id FROM faq_categories WHERE slug='pratique'),
'Proposez-vous des voyages sur mesure ?',
'Do you offer tailor-made trips?',
'Absolument ! Notre Ã©quipe d''experts conÃ§oit des voyages entiÃ¨rement personnalisÃ©s selon vos envies, budget et disponibilitÃ©s. Contactez-nous pour un devis gratuit.',
'Absolutely! Our team of experts designs fully customized trips based on your wishes, budget and availability. Contact us for a free quote.',
2,TRUE);

