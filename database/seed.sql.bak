((SELECT id FROM destinations WHERE slug='chefchaouen'),'Emma Wilson','Royaume-Uni',5,'Chefchaouen est une ville de rÃªve. Chaque ruelle est une photo. Organisation impeccable, guide fantastique.','2025-04-10',TRUE,TRUE),
