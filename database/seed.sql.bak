((SELECT id FROM destinations WHERE slug='dubai'),'Ahmed Al-Rashid','Ã‰mirats arabes unis',4,'Fantastique sÃ©jour Ã  DubaÃ¯. Le Burj Khalifa, le dÃ©sert, les souks dorÃ©s. Je recommande vivement.','2025-03-01',TRUE,TRUE),
