# ==============================================================================
# RT Voyage — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ==============================================================================

# Application
FLASK_ENV=development
SECRET_KEY=change_this_super_secret_key_in_production_2026

# ── Base de données ──────────────────────────────────────────────────────────
# Option 1 : PostgreSQL local (Docker Compose) — défaut
POSTGRES_DB=rtvoyage
POSTGRES_USER=rtvoyage_user
POSTGRES_PASSWORD=rtvoyage_secret_2026
DATABASE_URL=postgresql://rtvoyage_user:rtvoyage_secret_2026@localhost:5432/rtvoyage

# Option 2 : Supabase (PostgreSQL cloud gratuit — prod VPS)
# DATABASE_URL=postgresql://postgres.XXXXXX:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Option 3 : SQLite (dev rapide / tests / CI)
# Laisser DATABASE_URL vide → SQLite automatique dans flask/rtvoyage.db
# DATABASE_URL=
# SQLITE_PATH=/chemin/personnalise/rtvoyage.db

# ── Google APIs ──────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# ── PgAdmin (Docker seulement) ───────────────────────────────────────────────
PGADMIN_EMAIL=admin@rtvoyage.com
PGADMIN_PASSWORD=admin2026

# ── Upload ───────────────────────────────────────────────────────────────────
MAX_CONTENT_LENGTH=16777216
# UPLOAD_FOLDER=/var/www/rtvoyage/flask/app/static/images/uploads
